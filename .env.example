# Copy to .env.local and fill in. Never commit real values.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY (no NEXT_PUBLIC_ prefix). Supabase > Project Settings > API > service_role.
# Required by: /api/webhooks/arifpay, /api/ads/*, /api/pay/[token]/receipt, /api/watchdog/ingest
SUPABASE_SERVICE_ROLE_KEY=

# HMAC-SHA256 secret used to verify Arifpay webhooks (header: x-arifpay-signature).
# In production the webhook returns 503 until this is set.
ARIFPAY_WEBHOOK_SECRET=

# Shared secret for external compliance feeds posting to /api/watchdog/ingest (header: x-watchdog-secret).
WATCHDOG_INGEST_SECRET=

# ---- Merchant registration / sign-in -------------------------------------------------
# Signs session cookies and hashes one-time codes. 32+ random characters, e.g. `openssl rand -hex 32`.
SESSION_SECRET=

# TEST PHASE: leave unset (or anything but "true") and sign-in is open: anyone with the link can use the
# terminal and every dashboard, and OTP codes are shown on screen. Set to "true" to require a session.
# NOTE: enforcement is session-level only. Per-merchant data ownership and an admin role are not built yet.
AUTH_ENFORCED=

# SMS gateway for one-time codes (required when AUTH_ENFORCED=true). 2Pay POSTs { "to", "message" } as JSON here.
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=

# ---- Payment rails (see docs/RAIL_INTEGRATION.md) ------------------------------------
# simulated (default): payers are "authorized" instantly, no money moves. Demos only.
# live: payers are sent to the rail; only a verified provider callback can mark a sale paid.
RAIL_MODE=simulated
RAIL_PROVIDER=arifpay
# Public https origin of this deployment. Used for provider success/cancel/notify URLs. REQUIRED in live mode.
PUBLIC_BASE_URL=

# Arifpay. In sandbox mode (default session path) the published sandbox key is used if this is blank.
ARIFPAY_API_KEY=
ARIFPAY_BASE_URL=https://gateway.arifpay.org
# Sandbox default: /api/sandbox/c2b/session . SET THE PRODUCTION PATH from Arifpay's docs before going live.
ARIFPAY_SESSION_PATH=
ARIFPAY_DEFAULT_EMAIL=
# Authenticates provider callbacks (32+ random characters). REQUIRED outside sandbox.
ARIFPAY_WEBHOOK_SECRET=
# Optional: ARIFPAY_SIM_MODE=SUCCESS|FAIL (sandbox only), ARIFPAY_FEE_SOURCE=MERCHANT|CUSTOMER,
# ARIFPAY_METHOD_CODES={"Telebirr":"<code>"}, ARIFPAY_BANK_CODES={"Awash Bank":"<code>"}, ARIFPAY_USE_BENEFICIARIES=true

# ---- Access control (active when AUTH_ENFORCED=true) ---------------------------------
# Phones allowed into the admin hub, comma separated, e.g. 0911223344,0711223344
ADMIN_PHONES=
# Protects the daily reconciliation job (Vercel Cron sends it automatically when set).
CRON_SECRET=

# Single-transaction ETB amount that auto-drafts an AML SAR for the FIS. Confirm with compliance.
AML_SAR_THRESHOLD_ETB=500000

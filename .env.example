# Copy to .env.local and fill in. Never commit real values.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY (no NEXT_PUBLIC_ prefix). Supabase > Project Settings > API > service_role.
# Required by: /api/webhooks/arifpay, /api/ads/*, /api/pay/[token]/receipt, /api/watchdog/ingest
SUPABASE_SERVICE_ROLE_KEY=

# HMAC-SHA256 secret used to verify Arifpay webhooks (header: x-arifpay-signature).
# In production the webhook returns 503 until this is set.
ARIFPAY_WEBHOOK_SECRET=

# Shared secret for external compliance feeds posting to /api/watchdog/ingest (header: x-watchdog-secret).
WATCHDOG_INGEST_SECRET=

# ---- Merchant registration / sign-in -------------------------------------------------
# Signs session cookies and hashes one-time codes. 32+ random characters, e.g. `openssl rand -hex 32`.
SESSION_SECRET=

# TEST PHASE: leave unset (or anything but "true") and sign-in is open: anyone with the link can use the
# terminal and every dashboard, and OTP codes are shown on screen. Set to "true" to require a session.
# NOTE: enforcement is session-level only. Per-merchant data ownership and an admin role are not built yet.
AUTH_ENFORCED=

# SMS gateway for one-time codes (required when AUTH_ENFORCED=true). 2Pay POSTs { "to", "message" } as JSON here.
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=

# ---- Payment rails (see docs/RAIL_INTEGRATION.md) ------------------------------------
# simulated (default): payers are "authorized" instantly, no money moves. Demos only.
# live: payers are sent to the rail; only a verified provider callback can mark a sale paid.
RAIL_MODE=simulated
RAIL_PROVIDER=arifpay
# Public https origin of this deployment. Used for provider success/cancel/notify URLs. REQUIRED in live mode.
PUBLIC_BASE_URL=

# Arifpay. In sandbox mode (default session path) the published sandbox key is used if this is blank.
ARIFPAY_API_KEY=
ARIFPAY_BASE_URL=https://gateway.arifpay.org
# Sandbox default: /api/sandbox/c2b/session . SET THE PRODUCTION PATH from Arifpay's docs before going live.
ARIFPAY_SESSION_PATH=
ARIFPAY_DEFAULT_EMAIL=
# Authenticates provider callbacks (32+ random characters). REQUIRED outside sandbox.
ARIFPAY_WEBHOOK_SECRET=
# Optional: ARIFPAY_SIM_MODE=SUCCESS|FAIL (sandbox only), ARIFPAY_FEE_SOURCE=MERCHANT|CUSTOMER,
# ARIFPAY_METHOD_CODES={"Telebirr":"<code>"}, ARIFPAY_BANK_CODES={"Awash Bank":"<code>"}, ARIFPAY_USE_BENEFICIARIES=true

# ---- Access control (active when AUTH_ENFORCED=true) ---------------------------------
# Phones allowed into the admin hub, comma separated, e.g. 0911223344,0711223344
ADMIN_PHONES=
# Protects the daily reconciliation job (Vercel Cron sends it automatically when set).
CRON_SECRET=

# Single-transaction ETB amount that auto-drafts an AML SAR for the FIS. Confirm with compliance.
AML_SAR_THRESHOLD_ETB=500000

# ---- V2.1 ----------------------------------------------------------------------------
# Live payments are refused for merchants whose business details (KYC) an admin has not approved. Set to "false" to relax.
KYC_REQUIRED_FOR_LIVE=true
# Largest amount a customer may type on a shop QR / sticker page (ETB). Default 20000.
STATIC_QR_MAX_ETB=20000
# Smart routing across providers, e.g. {"default":["arifpay"],"Telebirr":["telebirr","arifpay"]}. Keys are institution names
# (or "default"); values are provider ids in order of preference. Providers that are failing are tried last, not removed.
# Unset = the single RAIL_PROVIDER.
RAIL_ROUTING=
# "Open my bank app" links, e.g. {"Telebirr":"https://...{url}"}. {url} is replaced by the payment link; web checkout is the fallback.
RAIL_APP_LINKS=
# The daily retention job (/api/cron/retention) deletes expired unpaid payment links and payer phone numbers older than this
# many days. Unset = the job does nothing. Agree the period with counsel before enabling.
RETENTION_PURGE_DAYS=
# V2.3: per-app links that open the CUSTOMER's own bank or wallet app. Nothing is built in: each institution supplies its link format.
# {"Telebirr":"https://...?pay={url}","CBE Birr":{"android":"intent://...#Intent;scheme=..;package=..;S.browser_fallback_url={url};end","ios":"scheme://pay?data={payload}","any":"https://...{url}"}}
# (RAIL_APP_LINKS above also accepts this object form.) Placeholders: {url} {payload} {amount} {ref}
# The national ETHQR merchant-account template from EthSwitch / the National Bank (tag 26-51, guid, sub-fields). Needed only for {payload} links.
ETHQR_TEMPLATE=
# Leave unset: waiters must use the 2Pay Android app (a browser cannot tap to pay). "true" allows browsers, for testing only.
ALLOW_BROWSER_NODES=
# Shown on the Terms and Privacy pages as the address for questions and data requests.
NEXT_PUBLIC_LEGAL_CONTACT=

# ---- V2.4 ----------------------------------------------------------------------------
# Encrypts account numbers, TINs and national-ID names in the database (AES-256-GCM). 32 random bytes, base64: openssl rand -base64 32
# BACK THIS UP. Without it the encrypted fields cannot be read. Unset = stored as before (/api/health shows security.fieldEncryption: false).
DATA_ENCRYPTION_KEY=
# Only while rotating keys: the previous key, so existing rows still open. Rows are re-sealed under the new key when saved.
DATA_ENCRYPTION_KEY_PREV=
# National ID (Fayda) sign-in for owner KYC. All three come from the National ID Program when your organisation is onboarded.
FAYDA_ISSUER=
FAYDA_CLIENT_ID=
# The private key (JWK, one line of JSON) whose PUBLIC half you registered with Fayda. Used to sign the client assertion (private_key_jwt, RS256).
FAYDA_PRIVATE_JWK=
# Optional: defaults to PUBLIC_BASE_URL + /api/fayda/callback, "openid profile", and no acr_values.
FAYDA_REDIRECT_URI=
FAYDA_SCOPES=
FAYDA_ACR_VALUES=
# With real money (RAIL_MODE=live) the owner's Fayda verification is MANDATORY by default. Set "false" only to relax it on purpose.
KYC_REQUIRE_FAYDA=
# EthSwitch bank codes for "transfer to other bank" links, e.g. {"Awash Bank":"<code>"}. Supplied by EthSwitch, never guessed.
ETS_BANK_CODES=

# ---- V2.5 ----------------------------------------------------------------------------
# Fayda e-KYC by FAN + one-time code: the gateway address and key from the National ID Program (the request format is theirs; see docs).
FAYDA_EKYC_URL=
FAYDA_EKYC_KEY=
# Development only: any 16-digit FAN works and the code is 123456. IGNORED when RAIL_MODE=live.
FAYDA_SANDBOX_MODE=
# How long a ride-hailing checkout link stays usable, in minutes (default 30).
RIDE_SESSION_TTL_MINUTES=
# Optional logo CDN you are licensed to use: https URL containing {slug}, e.g. https://cdn.example.com/rails/{slug}.svg. Unset = local files only.
NEXT_PUBLIC_RAIL_LOGO_CDN=

# ---- V2.6: keeping transaction data in the country (see docs/DATA_RESIDENCY_AND_AI.md) -------------
# all (default) = today's single deployment. ui = the screens only (no database, no /api). core = the in-country API and database.
DEPLOY_ROLE=
# For a split deployment. On the screens host: where browsers find the API. On the core: which screens hosts may call it, the shared cookie
# domain, and where payment providers send callbacks. Needs a custom domain shared by both (for example app.2pay.et and api.2pay.et).
NEXT_PUBLIC_API_BASE=
UI_ORIGINS=
COOKIE_DOMAIN=
API_BASE_URL=
# The database address under its server-side name (the older NEXT_PUBLIC_SUPABASE_URL still works).
SUPABASE_URL=
# The AI layer (Google Cloud): OFF unless the level, the sink address and BOTH secrets are set. features = banded, pseudonymised events only;
# full = adds the exact amount, tip and fee. Needs a legal ruling first.
AI_EVENT_LEVEL=
AI_EVENT_SINK_URL=
# 16+ characters each. AI_EVENT_SECRET signs events going out and scores coming back; AI_PSEUDONYM_KEY makes the merchant and sale references.
AI_EVENT_SECRET=
AI_PSEUDONYM_KEY=
